#cloud-config
package_update: true
package_upgrade: false

packages:
  - haproxy

write_files:
  - path: /etc/haproxy/haproxy.cfg
    content: |
      global
          log /dev/log local0
          maxconn 2048
          user haproxy
          group haproxy
          daemon

      defaults
          log     global
          mode    http
          option  httplog
          option  dontlognull
          # A WordPress upload or a slow admin page can exceed the default
          # 50s server timeout, hence the wider server and client windows.
          timeout connect 5s
          timeout client  60s
          timeout server  60s
          errorfile 503 /etc/haproxy/errors/503.http

      frontend wordpress_in
          bind *:80
          # Preserve the visitor address for WordPress and for the logs.
          option forwardfor
          http-request set-header X-Forwarded-Proto http
          default_backend wordpress_pool

      backend wordpress_pool
          balance roundrobin
          # WordPress keeps sessions in cookies and media on NFS, so the
          # cookie below only improves cache locality; either node can serve
          # any request.
          cookie SRVID insert indirect nocache
          option httpchk GET /
          http-check expect status 200,301,302
${backend_servers}

      listen stats
          bind 127.0.0.1:8404
          stats enable
          stats uri /

runcmd:
  - systemctl enable --now haproxy
