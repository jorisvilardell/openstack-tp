global
    log /dev/log local0
    maxconn 2048
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5s
    timeout client  60s
    timeout server  60s
    errorfile 503 /etc/haproxy/errors/503.http

frontend wordpress_in
    bind *:80
    option forwardfor
    http-request set-header X-Forwarded-Proto http
    default_backend wordpress_pool

backend wordpress_pool
    balance roundrobin
    cookie SRVID insert indirect nocache
    option httpchk GET /
    http-check expect status 200,301,302
{% for host in groups['web'] | sort %}
    server {{ host }} {{ hostvars[host].ansible_host }}:80 check cookie {{ host }}
{% endfor %}

listen stats
    bind 127.0.0.1:8404
    stats enable
    stats uri /
